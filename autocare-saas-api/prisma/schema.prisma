generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  SERVICE_ADVISOR
  TECHNICIAN
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  CNG
}

enum Transmission {
  MANUAL
  AUTOMATIC
  CVT
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  SOLD
  SCRAPPED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Tenant {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  slug            String           @unique
  users           User[]
  branches        Branch[]
  customers       Customer[]
  vehicles        Vehicle[]
  services        ServiceHistory[]
  appointments    Appointment[]
  vehicleSequence VehicleSequence?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Branch {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @db.Uuid
  name                String
  phone               String
  email               String?
  addressLine1        String
  addressLine2        String?
  city                String
  stateProvince       String
  postalCode          String
  country             String
  timezone            String
  businessOpeningTime DateTime         @db.Time(0)
  businessClosingTime DateTime         @db.Time(0)
  isActive            Boolean          @default(true)
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services            ServiceHistory[]
  appointments        Appointment[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  @@unique([id, tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, name])
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(OWNER)
  isActive     Boolean  @default(true)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Customer {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  firstName    String
  lastName     String
  email        String?
  phone        String
  notes        String?
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, phone])
}

model VehicleSequence {
  tenantId     String @id @db.Uuid
  currentValue Int    @default(0)
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @db.Uuid
  customerId         String           @db.Uuid
  vehicleCode        String
  nickname           String?
  registrationNumber String?
  vin                String?
  make               String?
  model              String?
  variant            String?
  year               Int?
  color              String?
  engineNumber       String?
  engineSize         String?
  fuelType           FuelType?
  transmission       Transmission?
  purchaseDate       DateTime?
  currentMileage     Int
  lastServiceMileage Int?
  status             VehicleStatus    @default(ACTIVE)
  notes              String?
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  services           ServiceHistory[]
  appointments       Appointment[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  @@unique([tenantId, vehicleCode])
  @@unique([tenantId, registrationNumber])
  @@index([tenantId, customerId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, make, model])
}

model ServiceHistory {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  branchId       String   @db.Uuid
  vehicleId      String   @db.Uuid
  serviceDate    DateTime
  description    String
  currentMileage Int?
  totalAmount    Decimal  @db.Decimal(12, 2)
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, vehicleId, serviceDate])
  @@index([tenantId, branchId, serviceDate])
}

model Appointment {
  id                       String            @id @default(uuid()) @db.Uuid
  tenantId                 String            @db.Uuid
  branchId                 String            @db.Uuid
  customerId               String            @db.Uuid
  vehicleId                String            @db.Uuid
  appointmentDateTimeUtc   DateTime
  estimatedDurationMinutes Int
  serviceRequested         String
  status                   AppointmentStatus @default(SCHEDULED)
  notes                    String?
  createdBy                String            @db.Uuid
  tenant                   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                   Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer                 Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle                  Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  deletedAt                DateTime?

  @@unique([id, tenantId])
  @@index([tenantId, deletedAt, appointmentDateTimeUtc])
  @@index([tenantId, branchId, appointmentDateTimeUtc])
  @@index([tenantId, customerId, appointmentDateTimeUtc])
  @@index([tenantId, vehicleId, appointmentDateTimeUtc])
  @@index([tenantId, status, appointmentDateTimeUtc])
}
